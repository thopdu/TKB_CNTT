# ==============================================================================
# Biến môi trường mẫu cho hệ thống PDU Academic (tkb.pvantho.id.vn)
# Copy file này thành .env trên server: cp .env.example .env
# ==============================================================================

# Cổng lắng nghe máy chủ (Mặc định: 3005)
PORT=3005
NODE_ENV=production

# Tên miền chính thức của ứng dụng
APP_URL="https://tkb.pvantho.id.vn"

# Khóa API Google Gemini AI (Dùng cho Trợ lý Học vụ AI PDU)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# (Tùy chọn) Google OAuth 2.0 Client ID cho Đăng nhập Google Doanh nghiệp PDU
# Tạo tại Google Cloud Console -> APIs & Services -> Credentials
# Thêm Authorized JavaScript Origins: https://tkb.pvantho.id.vn
VITE_GOOGLE_CLIENT_ID=""
